DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-hosting
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,capacitor://localhost,https://localhost
# Leave DATABASE_URL unset to use local SQLite. Docker Compose supplies Postgres.
# DATABASE_URL=postgresql://neurolift:local-only@127.0.0.1:5432/neurolift
# Quick start: verification/reset messages print in the local backend terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For Mailpit choose django.core.mail.backends.smtp.EmailBackend.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=NeuroLift <hello@localhost>
# Preview HTTPS mail transport (server secret only):
# EMAIL_BACKEND=api.email_backend.ResendBackend
# RESEND_API_KEY=
# DEFAULT_FROM_EMAIL=NeuroLift <hello@your-verified-domain>
